# Agent Lens ADK — Environment Variables
# Copy to .env and fill in:  cp .env.example .env

# --- LLM inference endpoint (any OpenAI-compatible API) ---
API_KEY=your-api-key-here
BASE_URL=http://localhost:8321/v1
MODEL_ID=ollama/llama3.1:8b

# --- MLflow MCP (agent evaluation data source) ---
MLFLOW_MCP_URL=http://localhost:8080/mcp

# --- MLflow tracing (optional — auto-enabled when set) ---
# MLFLOW_TRACKING_URI=https://mlflow.example.com
# MLFLOW_EXPERIMENT_NAME=agent-lens-adk
# MLFLOW_TRACKING_INSECURE_TLS=true

# --- Server ---
PORT=8000
