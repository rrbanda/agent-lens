# Agent Lens Configuration
# Copy to .env and fill in your values

# === LLM Provider ===
# Any OpenAI-compatible API works: Gemini, OpenAI, Azure, Ollama, vLLM, etc.
# Gemini (default):
OPENAI_API_KEY=your-gemini-api-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Local Ollama:
# OPENAI_API_KEY=not-needed
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# === Official MLflow MCP ===
# In-cluster URL used by Hermes — the official mlflow mcp run server.
MLFLOW_MCP_URL=http://mlflow-mcp.redhat-ods-applications.svc.cluster.local:8080/mcp

# === MLflow MCP Server Environment ===
# These env vars go on the MLflow MCP deployment (NOT on Agent Lens).
# Set them with: oc set env deployment/mlflow-mcp <VAR>=<VALUE>
#
# REQUIRED if MLflow uses self-signed TLS (all OpenShift deployments):
# MLFLOW_TRACKING_INSECURE_TLS=true
#
# REQUIRED for LLM-judge skills (evaluate-agent, create-judge, red-team, eval-loop):
# OPENAI_API_KEY=sk-...  (must be a real OpenAI key — Gemini keys won't work for judges)
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Without MLFLOW_TRACKING_INSECURE_TLS, ALL MCP tool calls hang silently.
# Without OPENAI_API_KEY on the MCP server, LLM-judge scorers fail.
# The other 12 skills work without any key on the MCP server.

# === MLflow Tracking (instrumentation / local dev only) ===
MLFLOW_TRACKING_URI=http://127.0.0.1:5555

# === Kubernetes / OpenShift ===
NAMESPACE=agent-lens

# === Dashboard ===
DASHBOARD_PASSWORD=change-me-in-production

# === Agent API ===
API_SERVER_KEY=change-me-in-production

# === Evaluation (optional — for instrumentation/eval_agent.py) ===
AGENT_API_URL=http://your-agent:8642
AGENT_API_KEY=your-agent-api-key
MLFLOW_EXPERIMENT_NAME=your-agent-experiment
