# Agent Lens Configuration
# Copy to .env and fill in your values

# === MLflow Configuration ===
MLFLOW_TRACKING_URI=https://mlflow-server:8443
MLFLOW_WORKSPACE=default

# === LLM Provider (Gemini by default) ===
GEMINI_API_KEY=your-gemini-api-key-here

# === Kubernetes / OpenShift ===
NAMESPACE=agent-lens
MCP_NAMESPACE=agent-lens

# === Dashboard ===
DASHBOARD_PASSWORD=openshift

# === Agent API ===
API_SERVER_KEY=change-me-in-production

# === Evaluation (optional) ===
AGENT_API_URL=http://your-agent:8642
AGENT_API_KEY=your-agent-api-key
MLFLOW_EXPERIMENT_NAME=your-agent-experiment
